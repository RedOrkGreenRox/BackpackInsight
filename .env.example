# --- BackpackInsight configuration ---

# === Docker Compose self-detection ===
# COMPOSE_PROFILES controls which services docker compose starts:
#   * COMPOSE_PROFILES=local   → db + backend + web (local dev with frontend)
#   * COMPOSE_PROFILES=        → db + backend only (server, web on Cloudflare Pages)
# This is a standard docker compose feature (no --profile flag needed).
COMPOSE_PROFILES=local

# === Database ===
# SQLite is the local-dev default (bundled, no Docker/system deps).
# Postgres is for production / docker-compose with the `db` service.
DATABASE_URL=sqlite:./backpack_insight.db
# DATABASE_URL=postgres://admin:secret@localhost:5432/backpack_insight

# Postgres credentials (used when DATABASE_URL starts with postgres://).
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=backpack_insight
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1

# === RBackend ===
ROOT_ENV=development
BACKEND_BIND=127.0.0.1
ROOT_DB_ENABLED=true
ROOT_PUBLIC_BASE_URL=https://backpackinsight.pages.dev

# Per-IP rate limit for POST /api/profile.fb (token bucket, parity with Python
# slowapi). Format: "N/minute". "0" disables. Default 20/minute.
# ROOT_PROFILE_RATE_LIMIT=20/minute

# === Frontend (local web container, only with COMPOSE_PROFILES=local) ===
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5080

# === Security ===
# Server-side only. Never expose to browser JS. Required when ROOT_ENV=production.
API_SECRET=change-me-on-server

# === Docker mode (for scripts/run_docker.py) ===
# auto|local|server — run_docker.py uses this to set COMPOSE_PROFILES.
BACKPACK_DOCKER_MODE=auto
