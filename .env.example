# --- Docker Compose / RBackend Configuration ---

# Database credentials (Postgres — production / docker-compose).
# For local dev without Docker, comment these out and use the SQLite URL below.
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=backpack_insight
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1

# Connection URL. Postgres is used in docker-compose. SQLite is the local-dev
# default (no Docker / no system libsqlite3 required — bundled at build time).
# DATABASE_URL=sqlite:./backpack_insight.db
# DATABASE_URL=postgres://admin:secret@localhost:5432/backpack_insight

# RBackend mode
# Local:  development + BACKEND_BIND=127.0.0.1 + local web container
# Server: production  + BACKEND_BIND=0.0.0.0 + real API_SECRET + no web container
ROOT_ENV=development
BACKEND_BIND=127.0.0.1
ROOT_DB_ENABLED=true
ROOT_PUBLIC_BASE_URL=https://backpackinsight.pages.dev

# Per-IP rate limit for POST /api/profile.fb (token bucket, parity with Python
# slowapi). Format: "N/minute". "0" disables the limiter. Default 20/minute.
# ROOT_PROFILE_RATE_LIMIT=20/minute

# Local frontend container. Server deploy does not start it.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5080

# Server-side only. Never expose to browser JS.
API_SECRET=change-me-on-server

# Optional script override: local|server|auto
BACKPACK_DOCKER_MODE=auto

# Legacy Python/JSON backend toggles were removed.
