# --- Docker Compose / RBackend Configuration ---

# Database credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=backpack_insight
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1

# RBackend mode
# Local:  development + BACKEND_BIND=127.0.0.1 + local web container
# Server: production  + BACKEND_BIND=0.0.0.0 + real API_SECRET + no web container
ROOT_ENV=development
BACKEND_BIND=127.0.0.1
ROOT_DB_ENABLED=true
ROOT_PUBLIC_BASE_URL=https://backpackinsight.pages.dev

# Local frontend container. Server deploy does not start it.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5080

# Server-side only. Never expose to browser JS.
API_SECRET=change-me-on-server

# Optional script override: local|server|auto
BACKPACK_DOCKER_MODE=auto

# Legacy Python/JSON backend toggles were removed.
