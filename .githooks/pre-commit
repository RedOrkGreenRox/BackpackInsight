#!/usr/bin/env bash
# Перед коммитом обновляет docs/structure.md, если в коммите есть добавленные,
# удалённые или переименованные файлы: дерево проекта меняется только от них.
# Иначе CI (scripts/check_docs.py, проверка [FRESH]) падает на устаревшей структуре.
# Включается один раз на клон: git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
if git diff --cached --name-only --diff-filter=ADR | grep -q .; then
    python3 "$root/scripts/generate_structure.py" >/dev/null
    git add "$root/docs/structure.md"
fi
# Граф документации (scripts/docs_graph) пересобирается в target/docs-graph.html,
# когда в коммите меняются доки или сам сборщик графа.
if git diff --cached --name-only | grep -qE '^(docs/|README\.md$|scripts/docs_graph/)'; then
    python3 "$root/scripts/docs_graph/build.py" >/dev/null || echo "pre-commit: граф документации не собрался" >&2
fi
